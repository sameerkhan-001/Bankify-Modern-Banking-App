# Backend API base URL (including /api).
# Leave empty in development: requests go to "/api" and Vite proxies them to VITE_PROXY_TARGET.
# For a separately hosted API use e.g. https://api.example.com/api (then set CLIENT_ORIGIN
# on the backend and cookie settings as described in ../README.md).
VITE_API_URL=

# Where the dev/preview proxy forwards /api (default http://localhost:3000)
VITE_PROXY_TARGET=http://localhost:3000
