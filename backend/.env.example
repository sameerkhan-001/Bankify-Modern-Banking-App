# --- required ---
# Transfers use MongoDB transactions -> MongoDB must be a REPLICA SET (Atlas qualifies;
# for local use start mongod with --replSet rs0 and run rs.initiate(), see ../README.md)
MONGO_URI=mongodb://127.0.0.1:27017/bankify?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-string

# --- optional ---
PORT=3000
# Only needed when the frontend runs on another origin than the API (the Vite dev
# proxy does not need it). Comma separated.
CLIENT_ORIGIN=
# Cookie settings: for a frontend on a different SITE use COOKIE_SAMESITE=none and HTTPS
COOKIE_SAMESITE=lax
COOKIE_SECURE=

# Email notifications (skipped when these are empty)
EMAIL_USER=
CLIENT_ID=
CLIENT_SECRET=
REFRESH_TOKEN=

# Demo seed / funding scripts
SYSTEM_EMAIL=system@bankify.local
SYSTEM_PASSWORD=ChangeMe123!
DEMO_PASSWORD=Demo@1234
DEMO_PIN=123456
